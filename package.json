{
  "name": "motion-projects",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "python3 scripts/soundtrack.py",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "ramadan-clasico:audio": "python3 ramadan-clasico/soundtrack.py",
    "ramadan-clasico:render": "node scripts/render.mjs --src ramadan-clasico/motion.html --audio output/ramadan-clasico-soundtrack.wav --out output/ramadan-clasico.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
