{
  "name": "motion-projects",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "python3 scripts/soundtrack.py",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "compare:audio": "python3 scripts/compare_soundtrack.py",
    "compare:preview": "node scripts/render.mjs --src src/compare.html --preview --times 1.2,2.5,5.5,8.8,12.8,17.5,20.5,23.8",
    "compare:render": "node scripts/render.mjs --src src/compare.html --audio output/compare-soundtrack.wav --out output/compare.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
