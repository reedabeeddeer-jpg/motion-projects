{
  "name": "motion-projects",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "python3 scripts/soundtrack.py",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "iraq-uae:audio": "python3 scripts/iraq-uae-soundtrack.py",
    "iraq-uae:preview": "node scripts/render.mjs --src src/iraq-uae.html --preview --times 1.5,5.5,8.6,12.8,17,21",
    "iraq-uae:render": "node scripts/render.mjs --src src/iraq-uae.html --audio output/iraq-uae.wav --out output/iraq-uae.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
