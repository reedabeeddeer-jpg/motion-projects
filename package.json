{
  "name": "motion-projects",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "python3 scripts/soundtrack.py",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "ad:audio": "python3 scripts/ad_soundtrack.py",
    "ad:preview": "node scripts/render.mjs --src src/ad.html --preview --times 0.9,1.3,1.8,2.5,3.2,4.5,7,9.6",
    "ad:render": "node scripts/render.mjs --src src/ad.html --audio output/ad_soundtrack.wav --out output/ad.mp4",
    "ai:audio": "python3 scripts/soundtrack_ai.py",
    "ai:preview": "node scripts/render.mjs --src src/ai-tool.html --preview --times 1.5,4.2,7.4,8.9,10.8,14",
    "ai:render": "node scripts/render.mjs --src src/ai-tool.html --audio output/ai-tool-soundtrack.wav --out output/ai-tool.mp4",
    "calm:audio": "python3 scripts/calm_music.py",
    "calm:preview": "node scripts/render.mjs --src src/calm.html --preview --times 1,3.5,7,9,12,15,17.5",
    "calm:render": "node scripts/render.mjs --src src/calm.html --audio output/calm.wav --out output/calm.mp4",
    "cyber:audio": "python3 scripts/cyber_soundtrack.py",
    "cyber:preview": "node scripts/render.mjs --src src/cyber.html --preview --times 1,2.6,3.8,6.5,11.5,15,18.3,21",
    "cyber:render": "node scripts/render.mjs --src src/cyber.html --audio output/cyber-soundtrack.wav --out output/cyber.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "dependencies": {
    "three": "^0.160.0"
  }
}
