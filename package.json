{
  "name": "motion-projects",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "python3 scripts/soundtrack.py",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "calm:audio": "python3 scripts/calm_music.py",
    "calm:preview": "node scripts/render.mjs --preview --page src/calm.html --stills output/stills-calm --times 1,3.5,7,9,12,15,17.5",
    "calm:render": "node scripts/render.mjs --page src/calm.html --audio output/calm.wav --out output/calm.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
